<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Receptgyűjtemény" FontSize="22" Margin="0,0,0,15"/>
        <Button Content="Főételek" Click="Foetel_Click" Padding="8" Margin="0,5"/>
        <Button Content="Levesek" Click="Leves_Click" Padding="8" Margin="0,5"/>
        <Button Content="Desszertek" Click="Desszert_Click" Padding="8" Margin="0,5"/>
        <Button Content="Mit főzzek ma?" Click="Random_Click" Padding="8" Margin="0,5"/>
    </StackPanel>
</Window>