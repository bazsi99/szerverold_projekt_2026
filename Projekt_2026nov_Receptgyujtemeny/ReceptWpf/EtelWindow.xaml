<Window x:Class="ReceptWpf.EtelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReceptWpf"
        mc:Ignorable="d"
        Title="EtelWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Keresés (név vagy hozzávaló):" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSearch" Width="120" Margin="5,0"/>
                <Button Content="Keresés" Click="Search_Click" Padding="8,2"/>
                <Button Content="Mind" Click="All_Click" Padding="8,2" Margin="5,0"/>
            </StackPanel>
            <DataGrid x:Name="dg" IsReadOnly="True" AutoGenerateColumns="False"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*"/>
                    <DataGridTextColumn Header="Idő (perc)" Binding="{Binding ElkeszitesiIdoPerc}"/>
                    <DataGridTextColumn Header="Leírás" Binding="{Binding Leiras}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Név"/>
            <TextBox x:Name="txtName" Margin="0,0,0,5"/>
            <TextBlock Text="Leírás"/>
            <TextBox x:Name="txtDescription" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,5"/>
            <TextBlock Text="Idő (perc)"/>
            <TextBox x:Name="txtTime" Margin="0,0,0,10"/>
            <Button Content="Hozzáadás" Click="Add_Click" Margin="0,3" Padding="5"/>
            <Button Content="Módosítás" Click="Modify_Click" Margin="0,3" Padding="5"/>
            <Button Content="Törlés" Click="Delete_Click" Margin="0,3" Padding="5"/>
            <TextBlock Text="Hozzávalók" FontWeight="Bold" Margin="0,10,0,3"/>
            <ListBox x:Name="lbHozzavalok" Height="150" DisplayMemberPath="Szoveg"/>
        </StackPanel>
    </Grid>
</Window>
